# ── CreatorAE Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values before running the project.

# Required: OpenAI API key for embeddings and LLM
OPENAI_API_KEY=

# Optional: path to ChromaDB persistence directory (default: ./chroma_db)
CHROMA_DB_DIR=./chroma_db

# Optional: path to regulatory documents directory (default: ./docs)
DOCS_DIR=./docs

# Optional: OpenAI model for answer generation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
